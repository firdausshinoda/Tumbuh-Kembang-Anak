<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgRoot"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp"
        android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="4dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/bg_cardView">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Perkembangan dan Stimulasi"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/greenDark"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pilih kategori kemampuan anak"
                    android:textSize="@dimen/text_xs"
                    android:textColor="#718078"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/greenSoft">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Kelompok usia terpilih"
                                    android:textSize="@dimen/text_xs"
                                    android:textColor="@color/greenDark"/>
                                <TextView
                                    android:id="@+id/tv_usia"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="0 - 3 bulan"
                                    android:textSize="@dimen/text_md"
                                    android:textColor="@color/greenDark"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Panduan aktivitas untuk mendukung perkembangan si kecil."
                                    android:textSize="@dimen/text_xs"
                                    android:textColor="@color/greenDark" />
                            </LinearLayout>
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/white">
                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_margin="6dp"
                                    android:src="@drawable/ic_baby"
                                    app:tint="@color/greenPrimary" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGerakKasar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/graySoft"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/greenSoft">
                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_margin="16dp"
                                    android:src="@drawable/ic_baby"
                                    app:tint="@color/greenPrimary" />
                            </com.google.android.material.card.MaterialCardView>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Kemampuan Gerak Kasar"
                                    android:textSize="@dimen/text_md"
                                    android:textColor="@color/greenDark"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Gerakan tubuh, kepala, tangan, dan kaki."
                                    android:textSize="@dimen/text_xs"
                                    android:textColor="@color/greenDark" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginLeft="6dp"
                                android:src="@drawable/rounded_keyboard_arrow_right_24"
                                app:tint="@color/greenPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGerakHalus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="6dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/graySoft"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/blueSoft">
                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_margin="16dp"
                                    android:src="@drawable/ic_thumbs_up"
                                    app:tint="@color/bluePrimary" />
                            </com.google.android.material.card.MaterialCardView>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Kemampuan Gerak Halus"
                                    android:textSize="@dimen/text_md"
                                    android:textColor="@color/greenDark"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Koordinasi mata dan tangan serta meraih benda."
                                    android:textSize="@dimen/text_xs"
                                    android:textColor="@color/greenDark" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginLeft="6dp"
                                android:src="@drawable/rounded_keyboard_arrow_right_24"
                                app:tint="@color/greenPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBicaraBahasa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="6dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/graySoft"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/orangeSoft">
                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_margin="16dp"
                                    android:src="@drawable/ic_comment"
                                    app:tint="@color/orangePrimary" />
                            </com.google.android.material.card.MaterialCardView>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Kemampuan Bicara dan Bahasa"
                                    android:textSize="@dimen/text_md"
                                    android:textColor="@color/greenDark"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Mendengar, merespon suara, dan berkomunikasi."
                                    android:textSize="@dimen/text_xs"
                                    android:textColor="@color/greenDark" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginLeft="6dp"
                                android:src="@drawable/rounded_keyboard_arrow_right_24"
                                app:tint="@color/greenPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSosialisasiKemandirian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="6dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/graySoft"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="12dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="@color/pinkSoft">
                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_margin="16dp"
                                    android:src="@drawable/ic_heart_handshake"
                                    app:tint="@color/pinkPrimary" />
                            </com.google.android.material.card.MaterialCardView>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Kemampuan Bersosialisasi dan Kemandirian"
                                    android:textSize="@dimen/text_md"
                                    android:textColor="@color/greenDark"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Interaksi, reson sosial, dan aktivitas sehari-hari."
                                    android:textSize="@dimen/text_xs"
                                    android:textColor="@color/greenDark" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginLeft="6dp"
                                android:src="@drawable/rounded_keyboard_arrow_right_24"
                                app:tint="@color/greenPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>